{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" migration.profile.yaml check-profile-loaded.py --always",
            "statusMessage": "Checking migration profile...",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" migration.profile.yaml guard-readonly-paths.py",
            "statusMessage": "Checking read-only paths...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" migration.profile.yaml check-doc-rules.py",
            "statusMessage": "Loading document rules...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
