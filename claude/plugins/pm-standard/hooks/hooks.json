{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" pm.profile.yaml check-pm-profile.py --always",
            "statusMessage": "Checking project-management profile...",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" pm.profile.yaml guard-pm-baselines.py",
            "statusMessage": "Checking baseline protection...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" pm.profile.yaml check-pm-doc-rules.py",
            "statusMessage": "Loading management document rules...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
