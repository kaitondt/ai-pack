{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_pm_profile.py\"",
            "statusMessage": "Checking project-management profile...",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_pm_baselines.py\"",
            "statusMessage": "Checking baseline protection...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_pm_doc_rules.py\"",
            "statusMessage": "Loading management document rules...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
