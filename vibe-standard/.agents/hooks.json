{
  "pack-hooks": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python \"./hooks/check_vibe_profile.py\"",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"./hooks/guard_vibe_bash.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_to_file|multi_replace_file_content|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python \"./hooks/guard_vibe_paths.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}