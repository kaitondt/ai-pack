{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/_run_hook.py\" pm.profile.yaml check_pm_profile.py --always",
            "statusMessage": "Checking project-management profile...",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/_run_hook.py\" pm.profile.yaml guard_pm_baselines.py",
            "statusMessage": "Checking baseline protection...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/_run_hook.py\" pm.profile.yaml check_pm_doc_rules.py",
            "statusMessage": "Loading management document rules...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
