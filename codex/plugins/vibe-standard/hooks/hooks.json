{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/_run_hook.py\" vibe.profile.yaml check_vibe_profile.py --always",
            "statusMessage": "Loading vibe state...",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/_run_hook.py\" vibe.profile.yaml guard_vibe_bash.py",
            "statusMessage": "Checking for irreversible commands...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/_run_hook.py\" vibe.profile.yaml guard_vibe_paths.py",
            "statusMessage": "Checking for secrets and protected paths...",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/_run_hook.py\" vibe.profile.yaml check_slice_size.py",
            "statusMessage": "Checking slice size...",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
